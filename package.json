{
	"name": "website",
	"version": "8.0.0",
	"private": true,
	"scripts": {
		"===== SETUP =====": "",
		"husky:install": "husky",
		"===== DEV =====": "",
		"dev": "npm-run-all --parallel build:env-file dev:next",
		"dev:next": "next dev",
		"build:ts": "tsc --noEmit",
		"build:env-file": "tsx --tsconfig ./scripts/tsconfig.json scripts/src/env-file.ts",
		"===== PROD =====": "",
		"build": "next build",
		"start": "next start",
		"===== FORMATTING =====": "",
		"lint": "eslint",
		"format": "prettier --write \"./src/**/*.{ts,tsx,json,css,mjs,js}\"",
		"===== STORYBOOK =====": "",
		"storybook:dev": "storybook dev -p 6006",
		"storybook:build": "storybook build",
		"===== UTILS =====": "",
		"script:code-stats": "tokei ./src"
	},
	"dependencies": {
		"@base-ui/react": "^1.3.0",
		"auto-bind": "^5.0.1",
		"class-variance-authority": "^0.7.1",
		"classnames": "^2.5.1",
		"developer-icons": "^6.0.5",
		"hoist-non-react-statics": "^3.3.2",
		"lucide-react": "^0.562.0",
		"mdx-bundler": "^10.1.1",
		"next": "16.2.0",
		"radix-ui": "^1.4.3",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-error-boundary": "^6.0.3",
		"remeda": "^2.33.1",
		"sonner": "^2.0.7",
		"sugar-high": "^0.9.5",
		"tailwind-merge": "^3.4.0"
	},
	"devDependencies": {
		"@eslint/css": "^0.14.1",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.0",
		"@tailwindcss/postcss": "^4",
		"@types/dom-to-image": "^2.6.7",
		"@types/hoist-non-react-statics": "^3.3.7",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^10.2.0",
		"eslint-config-next": "^16.2.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-storybook": "^10.3.3",
		"globals": "^17.0.0",
		"jiti": "^2.6.1",
		"lint-staged": "^16.2.7",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.6",
		"prettier": "^3.7.4",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0"
	},
	"optionalDependencies": {
		"@storybook/addon-docs": "^10.3.3",
		"@storybook/addon-vitest": "^10.3.3",
		"@storybook/nextjs-vite": "^10.3.3",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitest/browser-playwright": "^4.1.1",
		"@vitest/coverage-v8": "^4.1.1",
		"envfile": "^7.1.0",
		"husky": "^9.1.7",
		"playwright": "^1.58.2",
		"storybook": "^10.3.3",
		"vite": "^8.0.3",
		"vitest": "^4.1.1"
	},
